# MT5 terminal must already be installed and logged into the desired account.
# No broker password is stored by this link.
NEOFL_MT5_MCP_HOST=127.0.0.1
NEOFL_MT5_MCP_PORT=8765
# Set a long random token before exposing the MCP endpoint beyond localhost.
NEOFL_MT5_MCP_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

# Agent-side connection settings
MCP_URL=http://127.0.0.1:8765/mcp
MCP_NAME=NeoFL MT5 Live Terminal
